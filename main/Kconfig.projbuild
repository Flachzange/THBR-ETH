menu "THBR — Thread Border Router"

    choice THBR_TRANSPORT
        prompt "Backbone transport"
        default THBR_TRANSPORT_TAP
        help
            Select the network interface that carries infrastructure traffic
            between the Thread mesh and the LAN.

        config THBR_TRANSPORT_TAP
            bool "Ethernet frames over USB serial (host TAP)"
            help
                A real L2 netif transported through USB-Serial/JTAG using
                SLIP framing. Host side: tools/tap_pump.py.

        config THBR_TRANSPORT_PPP
            bool "PPP over USB serial"
            help
                Carries IP correctly, but the border-router library does not
                route over this point-to-point netif. Kept as a control case.

        config THBR_TRANSPORT_W5500
            bool "W5500 SPI Ethernet (Eth-Bug-PoE)"
            help
                Physical 10/100 Ethernet. USB remains a diagnostic console;
                no TAP pump or permanently attached host is needed.
    endchoice

    config THBR_W5500_MISO_GPIO
        int "W5500 MISO GPIO"
        depends on THBR_TRANSPORT_W5500
        default 2
        range 0 30

    config THBR_W5500_INT_GPIO
        int "W5500 interrupt GPIO"
        depends on THBR_TRANSPORT_W5500
        default 4
        range 0 30

    config THBR_W5500_CS_GPIO
        int "W5500 chip-select GPIO"
        depends on THBR_TRANSPORT_W5500
        default 5
        range 0 30

    config THBR_W5500_SCLK_GPIO
        int "W5500 clock GPIO"
        depends on THBR_TRANSPORT_W5500
        default 6
        range 0 30

    config THBR_W5500_MOSI_GPIO
        int "W5500 MOSI GPIO"
        depends on THBR_TRANSPORT_W5500
        default 7
        range 0 30

    config THBR_W5500_RESET_GPIO
        int "W5500 reset GPIO (-1 if not connected)"
        depends on THBR_TRANSPORT_W5500
        default -1
        range -1 30

    config THBR_W5500_SPI_CLOCK_MHZ
        int "W5500 SPI clock (MHz)"
        depends on THBR_TRANSPORT_W5500
        default 20
        range 5 40

    config THBR_W5500_HOSTNAME
        string "W5500 DHCP hostname"
        depends on THBR_TRANSPORT_W5500
        default "thbr-eth"

    config THBR_TAP_MTU
        int "Backbone MTU (TAP transport)"
        depends on THBR_TRANSPORT_TAP
        default 1500
        range 576 1500

    config THBR_TAP_STICK_IPV4
        string "Stick IPv4 address (TAP transport)"
        depends on THBR_TRANSPORT_TAP
        default "192.168.45.2"

    config THBR_TAP_HOST_IPV4
        string "Host IPv4 address (TAP transport)"
        depends on THBR_TRANSPORT_TAP
        default "192.168.45.1"
        help
            Also the destination for the UDP log stream.

    config THBR_TAP_NETMASK
        string "Backbone netmask (TAP transport)"
        depends on THBR_TRANSPORT_TAP
        default "255.255.255.0"


    config THBR_CONSOLE_GRACE_MS
        int "Plain-console grace window before PPP takes the USB port (ms)"
        default 3000
        range 0 30000
        help
            The C6 has a single USB-Serial/JTAG port and PPP claims it.  For
            this long after boot the console stays readable as plain text, so
            a boot failure is diagnosable without a UART adapter.  Set 0 to
            hand over immediately (production), raise it while bringing up.

    config THBR_INFO_PORT
        int "TCP port of the firmware info API (/version, /status)"
        default 8082
        range 1 65535
        help
            Identifies the firmware to the host-side container, which
            decides from it whether the stick needs flashing.  Separate
            from the ot-br REST API on port 80 so it answers even when
            the border router does not come up.

    config THBR_LOG_UDP_PORT
        int "UDP port for logs after the handover"
        default 5514
        range 1 65535
        help
            Once PPP is up, ESP_LOG output is streamed to this UDP port on the
            PPP peer, backlog first.  On the host:  nc -u -l -p 5514

    config THBR_BACKBONE_WAIT_MS
        int "How long to wait for the backbone before starting the BR (ms)"
        default 60000
        range 1000 600000

    config THBR_ENABLE_BORDER_ROUTER
        bool "Start the OpenThread border router (stage 2)"
        default n
        select OPENTHREAD_ENABLED
        select OPENTHREAD_BORDER_ROUTER
        help
            Stage 1 builds the PPP backbone alone, which is what proves the
            serial IP link before anything depends on it.  Enable this for
            stage 2, where the border router binds to that netif — the
            project's go/no-go point, since the BR implementation is a
            prebuilt binary (see PLAN.md phase 3).


    config THBR_BLE_PROXY_URI
        string "Matter server BLE proxy endpoint"
        default "" if THBR_TRANSPORT_W5500
        default "ws://192.168.45.1:5580/ble"
        help
            Where the BLE proxy dials in.  The Matter server offers this on
            the same port as its control interface, under /ble.  The default
            points at the host on the other end of the backbone.

    config THBR_HEAP_PROBE
        bool "Heap census endpoint (investigation build, NOT for release)"
        default n
        help
            Adds GET /heap: per-region free/allocated bytes, block counts and
            the largest free block — the three numbers that tell a leak from
            fragmentation, which esp_get_free_heap_size() alone cannot.

            With CONFIG_HEAP_TRACING_STANDALONE also enabled, POST /heap
            {"trace":"start","records":n} runs a LEAKS-mode trace and GET
            /heap/leaks reports the still-held blocks grouped by the return
            address that allocated them.  The trace buffer comes out of the
            heap under investigation (about 40 bytes per record), so it is off
            until asked for.

            A release build leaves this off: the endpoint exposes allocator
            internals and the tracing hooks cost time on every malloc.

endmenu
